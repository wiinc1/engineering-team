{
  "LangGraphCheckpointStorageUnavailable": {
    "expr": "increase(langgraph_checkpoint_errors_total{code=\"langgraph_checkpoint_unavailable\"}[5m]) > 0",
    "for": "0m",
    "severity": "critical"
  },
  "LangGraphCheckpointWriteLatencyHigh": {
    "expr": "histogram_quantile(0.95, sum(rate(langgraph_checkpoint_write_latency_ms_bucket[5m])) by (le)) > 250",
    "for": "5m",
    "severity": "warning"
  },
  "LangGraphCheckpointReadLatencyHigh": {
    "expr": "histogram_quantile(0.95, sum(rate(langgraph_checkpoint_read_latency_ms_bucket[5m])) by (le)) > 300",
    "for": "5m",
    "severity": "warning"
  },
  "LangGraphCheckpointCorruption": {
    "expr": "increase(langgraph_checkpoint_errors_total{code=\"langgraph_state_invalid\"}[5m]) > 0",
    "for": "0m",
    "severity": "critical"
  },
  "LangGraphTenantRejectionSpike": {
    "expr": "increase(langgraph_tenant_rejections_total[5m]) >= 3",
    "for": "0m",
    "severity": "critical"
  },
  "LangGraphVersionMismatch": {
    "expr": "increase(langgraph_version_mismatch_total[5m]) > 0",
    "for": "0m",
    "severity": "critical"
  },
  "LangGraphPoolSaturation": {
    "expr": "langgraph_pool_waiting_requests > 0",
    "for": "2m",
    "severity": "critical"
  },
  "LangGraphStaleThreads": {
    "expr": "langgraph_stale_threads > 0",
    "for": "15m",
    "severity": "warning"
  }
}
