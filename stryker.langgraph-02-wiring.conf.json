{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/langgraph-equivalence.test.js tests/unit/langgraph-production-ports.test.js"
  },
  "mutate": [
    "lib/software-factory/langgraph/equivalence.js",
    "lib/software-factory/langgraph/production-ports.js",
    "lib/task-platform/langgraph-lifecycle-services.js"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 80, "break": 80 }
}
