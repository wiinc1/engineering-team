{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/langgraph-lifecycle.test.js tests/unit/langgraph-lifecycle-runtime.test.js"
  },
  "mutate": [
    "lib/software-factory/langgraph/lifecycle.js",
    "lib/software-factory/langgraph/lifecycle-runtime.js"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 80, "break": 80 }
}
