{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/job-runtime-contracts.test.js tests/unit/job-runtime-effect-ledger.test.js tests/unit/job-runtime-port-handlers.test.js tests/unit/job-runtime-workloads.test.js"
  },
  "mutate": [
    "lib/job-runtime/effect-ledger.js",
    "lib/job-runtime/handlers.js",
    "lib/job-runtime/policies.js",
    "lib/job-runtime/port.js",
    "lib/job-runtime/workload-handlers.js",
    "lib/job-runtime/workload-producers.js"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
