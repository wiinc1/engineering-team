{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/runtime-release-evidence.test.js tests/unit/runtime-cutover.test.js"
  },
  "mutate": [
    "lib/release-gates/evidence-collector.js",
    "lib/release-gates/runtime-evidence.js",
    "lib/runtime-cutover/index.js"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 80, "break": 80 }
}
