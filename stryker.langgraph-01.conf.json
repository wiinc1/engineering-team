{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/unit/langgraph-runtime.test.js tests/unit/langgraph-mutation-contracts.test.js tests/property/langgraph-state.property.test.js tests/security/langgraph-runtime.security.test.js"
  },
  "mutate": [
    "lib/software-factory/langgraph/config.js",
    "lib/software-factory/langgraph/errors.js",
    "lib/software-factory/langgraph/identity.js",
    "lib/software-factory/langgraph/state.js"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 85, "break": 85 }
}
